# AI Provider Layer — BlankUp can use OmniRoute, OpenAI Direct, Cloudflare, Google Gemini in parallel
# Select primary provider: omniroute | openai | cloudflare | google-gemini | auto (fallback order)
AI_PROVIDER=auto

# Strict single-provider mode — when true, ONLY the explicitly selected
# AI_PROVIDER is used and fallback to other providers is disabled.
# Intended for provider verification/testing. Default: false (fallback chain on).
AI_PROVIDER_STRICT=false

# Whole-chain budget (ms): caps total wall-clock across ALL providers + all retries,
# so an already-deducted credit can never hang for many minutes before being refunded.
# Each provider's per-attempt timeout is also clamped to whatever budget remains.
AI_CHAIN_TIMEOUT_MS=180000

# Base delay (ms) before retrying the SAME provider after a retryable failure
# (429 / 5xx / timeout). Exponential backoff + full jitter is applied on top.
AI_RETRY_BACKOFF_MS=1200

# Note: OPENAI_MODEL is the text/chat slot. Image generation uses the dedicated
# OPENAI_IMAGE_MODEL + OPENAI_IMAGE_SIZE (default gpt-image-2 / 1024x1024).


# OmniRoute — OpenAI-compatible gateway (http://localhost:20128/v1)
OMNIROUTE_ENABLED=false
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=openai/gpt-image-2
OMNIROUTE_TIMEOUT_MS=90000
OMNIROUTE_MAX_RETRIES=1

# OpenAI Direct (independent from OmniRoute)
OPENAI_ENABLED=false
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-image-2
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_TIMEOUT_MS=90000
OPENAI_MAX_RETRIES=1

# Cloudflare Workers AI (independent)
CLOUDFLARE_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-workers-ai-token
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_PROMPT_MODEL=@cf/meta/llama-3.1-8b-instruct
ENABLE_AI_PROMPT_ENHANCER=true
CLOUDFLARE_TIMEOUT_MS=90000
CLOUDFLARE_MAX_RETRIES=1

# Google Gemini — Google AI Studio (independent)
# The ACTIVE credential variable is GEMINI_API_KEY (server-side only, never exposed to the browser).
# Create a key at https://aistudio.google.com/apikey
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TIMEOUT_MS=120000
GEMINI_MAX_RETRIES=1

# VNPay Payment Gateway
# Get test credentials at https://sandbox.vnpayment.vn
VNP_TMN_CODE=your-merchant-code
VNP_HASH_SECRET=your-hash-secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/api/payment/vnpay-return

# SQL Server (SSMS / SQL Server Express or Default Instance)
# Leave SQL_USER and SQL_PASSWORD empty to use Windows Authentication
# SQL_SERVER=localhost           (or localhost\SQLEXPRESS for named instance)
# SQL_PORT=1433                 (default, ignored for named instances)
# SQL_DATABASE=BlankupDB        (auto-created if missing)
# SQL_USER=sa                   (omit for Windows Auth)
# SQL_PASSWORD=your-password    (omit for Windows Auth)
# REQUIRE_SQL_SERVER=true       (exit on DB failure instead of demo mode)

# JWT (access token signing)
JWT_SECRET=change-me-in-production

# Google OAuth (Login with Google)
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Facebook OAuth (Login with Facebook) — Authorization Code flow
# Create an App at https://developers.facebook.com/apps
# Add Valid OAuth Redirect URI in Facebook Login settings
FACEBOOK_ENABLED=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback
FACEBOOK_GRAPH_VERSION=v18.0

# Gmail SMTP (Email Verification, Forgot/Reset Password)
# Use Gmail App Password (not account password): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cubinlylom@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Blankup <cubinlylom@gmail.com>"

# CORS — Comma-separated list of allowed frontend origins
# REQUIRED in production. Example: https://blankup.vn,https://www.blankup.vn
# In development, localhost origins are allowed by default.
ALLOWED_ORIGINS=

# Password Reset token validity (minutes)
RESET_TOKEN_EXPIRY_MINUTES=60
# ---------------------------------------------------------------------------
# Bank transfer (QR) reconciliation via SePay
# ---------------------------------------------------------------------------
# Webhook endpoint to paste into the SePay dashboard:
#   /api/payment/sepay-webhook        (product orders)
#   /api/ai-plans/webhook/sepay       (AI credit purchases — already in use)
# BOTH endpoints reconcile orders, so a single SePay webhook URL works either way.
#
# SEPAY_WEBHOOK_SECRET: leave EMPTY to accept webhooks without header auth (the
# transfer must still match a real pending order code AND its exact amount).
# Set it here AND in the SePay dashboard to require authentication — an empty
# value on either side means payments will NOT be able to confirm themselves.
SEPAY_WEBHOOK_SECRET=your-sepay-webhook-secret

# Bank account shown on the checkout QR (single source of truth: the QR image,
# the transfer memo, and the reference the webhook matches all come from here).
BANK_ID=970422
BANK_NAME=MB Bank
BANK_ACCOUNT_NUMBER=0967145402
BANK_ACCOUNT_NAME=LE LY HUY
BANK_QR_TEMPLATE=compact2
